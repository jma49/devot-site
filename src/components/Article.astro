---
import '../styles/docs.css'
import type { DocRun, DocSection } from '../i18n/en/docs.ts'
import { localeOf, messages } from '../i18n/index.ts'
import Base from '../layouts/Base.astro'

interface Props {
  page: {
    title: string
    description: string
    heading: string
    intro: string
    sections: DocSection[]
  }
  /** The page one level up: the docs index or the blog. */
  up: { href: string; label: string }
  /** A line under the intro, such as the date a post went up. */
  byline?: { text: string; datetime: string }
  /** Lists the sections at the top, for a page read in parts. */
  toc?: boolean
  structuredData?: unknown
}

const t = messages(localeOf(Astro.url.pathname))
const { page, up, byline, toc = true, structuredData } = Astro.props
const isCode = (run: DocRun): run is { code: string } => typeof run === 'object' && 'code' in run
---

<Base title={page.title} description={page.description} structuredData={structuredData}>
  <article class="doc">
    <header class="doc__head">
      <a class="doc__up" href={up.href}>
        {up.label}
      </a>
      <h1 class="doc__title">{page.heading}</h1>
      <p class="doc__intro">{page.intro}</p>
      {byline && (
        <p class="doc__byline">
          <time datetime={byline.datetime}>{byline.text}</time>
        </p>
      )}
    </header>
    {toc && (
      <nav class="doc__toc" aria-labelledby="doc-toc-title">
        <h2 class="doc__toc-title" id="doc-toc-title">
          {t.docs.onThisPage}
        </h2>
        <ul>
          {page.sections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    {page.sections.map((section) => (
      <section class="doc__section" id={section.id} aria-labelledby={`${section.id}-title`}>
        <h2 id={`${section.id}-title`}>{section.title}</h2>
        {section.blocks.map((block) => {
          const runs = (items: DocRun[]) =>
            items.map((run) =>
              typeof run === 'string' ? (
                run
              ) : isCode(run) ? (
                <code>{run.code}</code>
              ) : (
                <a href={run.href}>{run.text}</a>
              ),
            )
          if (block.kind === 'text') return <p>{runs(block.runs)}</p>
          if (block.kind === 'code') {
            const code = block.lines.join('\n')
            return <pre
              class="doc__code"
              aria-label={block.label}
              tabindex="0"
            ><code>{code}</code></pre>
          }
          const items = block.items.map((item) => <li>{runs(item)}</li>)
          return block.ordered ? <ol>{items}</ol> : <ul>{items}</ul>
        })}
      </section>
    ))}
  </article>
</Base>
