---
import { messages } from '../i18n/index.ts'
import { DOWNLOAD_URL, REPO_URL } from '../site.ts'

const t = messages()
const sections = [
  { id: 'write', label: t.chrome.nav.write },
  { id: 'cards', label: t.chrome.nav.cards },
  { id: 'local-first', label: t.chrome.nav.localFirst },
  { id: 'download', label: t.chrome.nav.download },
]
---

<header class="site-header" data-site-header>
  <div class="bar" data-menu-scope>
    <a class="brand" href="/" aria-label={t.chrome.home}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">{t.siteName}</span>
    </a>

    <button class="motion-toggle motion-toggle-phone" type="button" data-motion-toggle>
      <span class="motion-label">{t.chrome.pause}</span>
      <svg class="motion-glyph" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M5.75 3.75v8.5M10.25 3.75v8.5"></path>
      </svg>
    </button>

    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-button
    >
      <span class="visually-hidden">{t.chrome.menu}</span>
      <span class="menu-glyph" aria-hidden="true">
        <i></i>
        <i></i>
      </span>
    </button>

    <nav class="nav" aria-label={t.chrome.navLabel}>
      <div class="nav-panel" id="site-menu" data-menu-panel>
        <ul class="nav-list" role="list">
          {sections.map(({ id, label }, index) => (
            <li class="nav-item" data-index={index}>
              <a class="nav-link" href={`/#${id}`} data-nav-section>
                {label}
              </a>
            </li>
          ))}
          <li class="nav-item nav-item-source" data-index={sections.length}>
            <a class="nav-link nav-source" href={REPO_URL}>
              {t.chrome.nav.source}
              <svg
                class="source-glyph"
                viewBox="0 0 16 16"
                width="12"
                height="12"
                aria-hidden="true"
              >
                <path d="M5.5 4.5h6v6M11.5 4.5l-7 7"></path>
              </svg>
            </a>
          </li>
        </ul>
        <div class="nav-cta">
          <a class="brand-button" href={DOWNLOAD_URL} aria-describedby="menu-note">
            <svg
              class="brand-button-glyph"
              viewBox="0 0 16 16"
              width="16"
              height="16"
              aria-hidden="true"
            >
              <path d="M8 2.5v7.25M4.75 6.75 8 10l3.25-3.25M3 13h10"></path>
            </svg>
            {t.download.label}
          </a>
          <p class="nav-note" id="menu-note">
            {t.chrome.downloadNote}
          </p>
        </div>
      </div>
    </nav>

    <button class="motion-toggle motion-toggle-wide" type="button" data-motion-toggle>
      <span class="motion-label">{t.chrome.pause}</span>
      <svg class="motion-glyph" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M5.75 3.75v8.5M10.25 3.75v8.5"></path>
      </svg>
    </button>
  </div>

  <div class="download-pill" data-download-pill>
    <span class="pill-mark" aria-hidden="true"></span>
    <span class="pill-text">
      <span class="pill-name">{t.siteName}</span>
      <span class="pill-note" id="pill-note">
        {t.chrome.downloadNote}
      </span>
    </span>
    <a class="brand-button brand-button-compact" href={DOWNLOAD_URL} aria-describedby="pill-note">
      <svg class="brand-button-glyph" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M8 2.5v7.25M4.75 6.75 8 10l3.25-3.25M3 13h10"></path>
      </svg>
      {t.download.label}
    </a>
  </div>
</header>

<script>
  import { startHeader } from '../scripts/header.ts'

  startHeader()
</script>

<style>
  /* The transparent borders on the bar and the pill become edges in forced colours. */
  :global(:root) {
    --chrome-glass: color-mix(in oklab, var(--color-surface-float-bar) 72%, transparent);
    --chrome-glass-strong: color-mix(in oklab, var(--color-surface-float-bar) 86%, transparent);
    --chrome-glass-filter: blur(20px) saturate(1.6);
    --chrome-edge: var(--color-line-float-bar);
    --chrome-shadow:
      0 1px 2px var(--color-shadow-popover-key),
      0 var(--shadow-float-bar-y) var(--shadow-float-bar-blur) var(--color-shadow-float-bar);
    --chrome-shadow-raised:
      0 1px 2px var(--color-shadow-popover-key), 0 10px 30px -8px var(--color-shadow-float-bar);
    --chrome-bar-height: 3.25rem;
    --chrome-inset: 0.75rem;
    --chrome-pill-rise: 0.5rem;
    --chrome-pill-scale: 0.95;
    --chrome-pill-duration: 350ms;
    --chrome-pill-aside: 1.5rem;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root) {
      --chrome-glass: color-mix(in oklab, var(--color-surface-float-bar) 70%, transparent);
      --chrome-glass-strong: color-mix(in oklab, var(--color-surface-float-bar) 84%, transparent);
    }
  }

  :global(html[data-menu-open]) {
    overflow: hidden;
  }

  /* Section links, and controls that focus scrolls into view, land below the floating bar rather
     than under it. A control not yet revealed rises by the reveal offset after the scroll, so the
     padding leaves room for that too. */
  :global(html) {
    scroll-padding-top: calc(
      var(--chrome-bar-height) + 2 * var(--chrome-inset) + var(--site-reveal-rise)
    );
  }

  .site-header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 50;
    height: calc(var(--chrome-bar-height) + var(--chrome-inset));
    pointer-events: none;
  }

  .bar,
  .download-pill {
    pointer-events: auto;
  }

  .bar {
    position: absolute;
    top: max(var(--chrome-inset), env(safe-area-inset-top));
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: fit-content;
    height: var(--chrome-bar-height);
    margin-inline: auto;
    padding: 0 var(--space-3) 0 var(--space-7);
    border-radius: var(--radius-capsule);
  }

  /* The glass sits on a pseudo-element: a backdrop-filter on the bar itself would make it the
     containing block of the fixed menu panel. */
  .bar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    border: 1px solid transparent;
    border-radius: inherit;
    background: var(--chrome-glass);
    box-shadow:
      inset 0 0 0 0.5px var(--chrome-edge),
      var(--chrome-shadow);
    backdrop-filter: var(--chrome-glass-filter);
    -webkit-backdrop-filter: var(--chrome-glass-filter);
    transition-property: background-color, box-shadow;
    transition-duration: var(--site-dur-reveal);
    transition-timing-function: var(--site-ease-text);
  }

  [data-scrolled] .bar::before {
    background: var(--chrome-glass-strong);
    box-shadow:
      inset 0 0 0 0.5px var(--chrome-edge),
      var(--chrome-shadow-raised);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 2.75rem;
    margin-inline-end: var(--space-6);
    border-radius: var(--radius-button);
    color: var(--site-color-text);
    font-size: var(--site-font-size-brand);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--site-tracking-brand);
    text-decoration: none;
  }

  .brand-mark,
  .pill-mark {
    flex: none;
    width: 1.625rem;
    aspect-ratio: 92 / 86;
    background: var(--site-brand-mark);
    mask: url('../assets/dove.svg') center / contain no-repeat;
    -webkit-mask: url('../assets/dove.svg') center / contain no-repeat;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding-inline: var(--space-6);
    border-radius: var(--radius-capsule);
    color: var(--site-color-text-muted);
    font-size: var(--site-font-size-small);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition-property: color, background-color;
    transition-duration: var(--motion-duration-hover);
    transition-timing-function: var(--motion-easing-out);
  }

  .nav-link:hover {
    background: var(--color-fill-tool-hover);
    color: var(--site-color-text);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0.3rem;
    left: 50%;
    width: 0.25rem;
    height: 0.25rem;
    margin-left: -0.125rem;
    border-radius: 50%;
    background: var(--site-brand-mark);
    opacity: 0;
    scale: 0;
    transition-property: opacity, scale;
    transition-duration: var(--site-dur-quick);
    transition-timing-function: var(--site-ease-out);
  }

  .nav-link[aria-current] {
    color: var(--site-color-text);
  }

  .nav-link[aria-current]::after {
    opacity: 1;
    scale: 1;
  }

  .nav-source::after {
    display: none;
  }

  .source-glyph {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate var(--motion-duration-hover) var(--motion-easing-out);
  }

  .nav-source:hover .source-glyph {
    translate: 1px -1px;
  }

  .nav-item-source {
    margin-inline-start: var(--space-2);
    padding-inline-start: var(--space-3);
    border-inline-start: 1px solid var(--site-color-line);
  }

  .nav-cta,
  .menu-button {
    display: none;
  }

  .motion-toggle {
    position: relative;
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-capsule);
    background: transparent;
    color: var(--site-color-text-muted);
    cursor: pointer;
    transition-property: color, background-color;
    transition-duration: var(--motion-duration-hover);
    transition-timing-function: var(--motion-easing-out);
  }

  /* Until the script gives it a state the toggle can do nothing, so it keeps its place unseen. */
  .motion-toggle:not([aria-pressed]) {
    visibility: hidden;
  }

  .motion-toggle[aria-pressed='true'] {
    background: var(--site-brand-fill);
    color: var(--site-brand-ink);
  }

  .motion-glyph {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  /* The toggle's name, shown as a tip below it on hover and keyboard focus. */
  .motion-label {
    position: absolute;
    top: calc(100% + var(--space-5));
    right: 0;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-button);
    background: var(--color-surface-popover);
    box-shadow:
      0 var(--shadow-popover-y) var(--shadow-popover-key-blur) var(--color-shadow-popover-key),
      0 var(--shadow-popover-y) var(--shadow-popover-ambient-blur)
        var(--color-shadow-popover-ambient);
    color: var(--site-color-text);
    font-size: var(--site-font-size-small);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--site-dur-quick) var(--site-ease-text);
  }

  .motion-toggle:focus-visible .motion-label {
    opacity: 1;
  }

  @media (hover: hover) {
    .motion-toggle[aria-pressed='false']:hover {
      background: var(--color-fill-tool-hover);
      color: var(--site-color-text);
    }

    .motion-toggle[aria-pressed='true']:hover {
      background: var(--site-brand-fill-hover);
    }

    .motion-toggle:hover .motion-label {
      opacity: 1;
    }
  }

  .motion-toggle-wide {
    margin-inline-start: var(--space-1);
  }

  .motion-toggle-phone {
    display: none;
  }

  .download-pill {
    position: fixed;
    bottom: max(var(--space-7), env(safe-area-inset-bottom));
    left: 0;
    right: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    width: fit-content;
    margin-inline: auto;
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-7);
    border: 1px solid transparent;
    border-radius: var(--radius-capsule);
    background: var(--chrome-glass-strong);
    box-shadow:
      inset 0 0 0 0.5px var(--chrome-edge),
      var(--chrome-shadow-raised);
    backdrop-filter: var(--chrome-glass-filter);
    -webkit-backdrop-filter: var(--chrome-glass-filter);
    opacity: 0;
    visibility: hidden;
    translate: 0 var(--chrome-pill-rise);
    scale: var(--chrome-pill-scale);
    transition-property: opacity, translate, scale, visibility;
    transition-duration:
      var(--chrome-pill-duration), var(--chrome-pill-duration), var(--chrome-pill-duration), 0s;
    transition-timing-function:
      var(--site-ease-out), var(--site-ease-media), var(--site-ease-media), linear;
    transition-delay: 0s, 0s, 0s, var(--chrome-pill-duration);
  }

  .download-pill[data-shown] {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    scale: 1;
    transition-delay: 0s;
  }

  .download-pill[data-aside] {
    translate: var(--chrome-pill-aside) 0;
  }

  /* On wide screens the pill is the download button alone, in the corner; header.ts moves it aside
     while it would cover a clip. Its note stays as the button's description. */
  @media (min-width: 800px) {
    .download-pill {
      right: max(var(--space-9), env(safe-area-inset-right));
      bottom: max(var(--space-9), env(safe-area-inset-bottom));
      left: auto;
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .download-pill .pill-mark {
      display: none;
    }

    .download-pill .pill-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .pill-text {
    display: grid;
    line-height: 1.25;
  }

  .pill-name {
    color: var(--site-color-text);
    font-size: var(--site-font-size-small);
    font-weight: var(--font-weight-semibold);
  }

  .pill-note {
    color: var(--site-color-text-muted);
    font-size: var(--font-size-footnote);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 799.98px) {
    .bar {
      left: var(--chrome-inset);
      right: var(--chrome-inset);
      width: auto;
      padding-inline: var(--space-7) var(--space-2);
    }

    .nav {
      order: 1;
    }

    .brand {
      margin-inline-end: auto;
    }

    .motion-toggle-phone {
      order: 2;
      display: inline-grid;
      width: 2.75rem;
      height: 2.75rem;
    }

    .motion-toggle-wide {
      display: none;
    }

    .menu-button {
      order: 3;
      position: relative;
      display: inline-grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
      border: 0;
      border-radius: var(--radius-capsule);
      background: transparent;
      color: var(--site-color-text);
      cursor: pointer;
      transition: background-color var(--motion-duration-hover) var(--motion-easing-out);
    }

    .menu-button:hover {
      background: var(--color-fill-tool-hover);
    }

    .menu-glyph {
      display: grid;
      width: 1.125rem;
      height: 0.75rem;
    }

    .menu-glyph i {
      grid-area: 1 / 1;
      width: 100%;
      height: 1.5px;
      border-radius: 1px;
      background: currentColor;
      transition:
        translate var(--site-dur-quick) var(--site-ease-media),
        rotate var(--site-dur-quick) var(--site-ease-media);
    }

    .menu-glyph i:first-child {
      align-self: start;
    }

    .menu-glyph i:last-child {
      align-self: end;
    }

    [data-menu-open] .menu-glyph i:first-child {
      translate: 0 0.3125rem;
      rotate: 45deg;
    }

    [data-menu-open] .menu-glyph i:last-child {
      translate: 0 -0.3125rem;
      rotate: -45deg;
    }

    .nav-panel {
      position: fixed;
      inset: 0;
      z-index: -1;
      display: none;
      flex-direction: column;
      gap: var(--space-10);
      padding: calc(var(--chrome-bar-height) + 2 * var(--chrome-inset) + var(--space-9))
        var(--site-gutter) max(var(--space-10), env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--site-color-page);
    }

    /* Display rather than visibility: the first link can take focus the moment the menu opens. */
    [data-menu-open] .nav-panel {
      display: flex;
    }

    [data-menu-open] .bar::before {
      background: transparent;
      box-shadow: none;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav-item {
      border-bottom: 1px solid var(--site-color-line);
    }

    .nav-item-source {
      margin: 0;
      padding: 0;
      border-inline-start: 0;
      border-bottom: 0;
    }

    .nav-link {
      width: 100%;
      min-height: 3.75rem;
      padding-inline: 0;
      border-radius: 0;
      color: var(--site-color-text);
      font-size: 1.75rem;
      font-weight: var(--font-weight-semibold);
      letter-spacing: -0.015em;
    }

    .nav-link:hover {
      background: transparent;
      color: var(--site-color-text-muted);
    }

    .nav-link::after {
      top: 50%;
      right: 0;
      bottom: auto;
      left: auto;
      width: 0.5rem;
      height: 0.5rem;
      margin: -0.25rem 0 0;
    }

    .source-glyph {
      width: 1rem;
      height: 1rem;
    }

    .nav-cta {
      display: grid;
      justify-items: center;
      gap: var(--space-6);
      margin-block-start: auto;
    }

    .nav-cta .brand-button {
      width: 100%;
      max-width: 24rem;
    }

    .nav-note {
      color: var(--site-color-text-muted);
      font-size: var(--site-font-size-small);
    }

    .download-pill {
      left: var(--chrome-inset);
      right: var(--chrome-inset);
      justify-content: space-between;
      width: auto;
      max-width: 26rem;
    }

    .download-pill .brand-button {
      min-height: 2.75rem;
    }
  }

  @media (max-width: 799.98px) and (prefers-reduced-motion: no-preference) {
    .nav-panel {
      transition: opacity var(--site-dur-quick) var(--site-ease-text);
    }

    .nav-item,
    .nav-cta {
      transition-property: opacity, translate;
      transition-duration: var(--site-dur-reveal);
      transition-timing-function: var(--site-ease-text), var(--site-ease-media);
    }

    @starting-style {
      [data-menu-open] .nav-panel,
      [data-menu-open] .nav-item,
      [data-menu-open] .nav-cta {
        opacity: 0;
      }

      [data-menu-open] .nav-item,
      [data-menu-open] .nav-cta {
        translate: 0 var(--site-reveal-rise);
      }
    }

    [data-menu-open] .nav-item[data-index='1'] {
      transition-delay: calc(1 * var(--site-stagger-step));
    }

    [data-menu-open] .nav-item[data-index='2'] {
      transition-delay: calc(2 * var(--site-stagger-step));
    }

    [data-menu-open] .nav-item[data-index='3'] {
      transition-delay: calc(3 * var(--site-stagger-step));
    }

    [data-menu-open] .nav-item[data-index='4'] {
      transition-delay: calc(4 * var(--site-stagger-step));
    }

    [data-menu-open] .nav-cta {
      transition-delay: calc(5 * var(--site-stagger-step));
    }
  }

  @media (max-width: 419.98px) {
    .pill-text {
      display: none;
    }

    .download-pill {
      gap: var(--space-5);
      width: fit-content;
      padding-inline-start: var(--space-6);
    }
  }
</style>
