---
import '../../styles/home/cards.css'
import { messages } from '../../i18n/index.ts'
import { media } from '../../media.ts'
import Clip from '../Clip.astro'

const t = messages()

type CardSlot = keyof typeof t.cards.items

interface Layout {
  slot: CardSlot
  shape: 'wide' | 'narrow'
  swatches?: boolean
}

// Rows alternate wide, narrow / narrow, wide.
const layout: Layout[] = [
  { slot: 'card-1', shape: 'wide', swatches: true },
  { slot: 'card-2', shape: 'narrow' },
  { slot: 'card-3', shape: 'narrow' },
  { slot: 'card-4', shape: 'wide' },
  { slot: 'card-5', shape: 'wide' },
  { slot: 'card-6', shape: 'narrow' },
]

/** The window corner a clip's crop keeps, which the frame rounds; a top-only crop keeps none. */
const cornerOf = (slot: CardSlot) => {
  const { edges } = media[slot]
  if (edges.includes('left')) return 'left'
  if (edges.includes('right')) return 'right'
  return 'top'
}

const themes = ['dawn', 'tide', 'sage', 'ember']

const cards = layout.map(({ slot, shape, swatches = false }) => {
  const copy = t.cards.items[slot]
  const keys = 'keys' in copy ? copy.keys : undefined
  return { slot, shape, corner: cornerOf(slot), swatches, copy, keys }
})
---

<section id="cards" class="cards" aria-labelledby="cards-title">
  <div class="cards-inner">
    <header class="cards-head">
      <h2 id="cards-title" data-reveal>
        {t.cards.label}
      </h2>
      <p class="cards-lead" data-reveal>
        {t.cards.lead}
      </p>
    </header>

    <ul class="cards-grid" role="list">
      {cards.map(({ slot, shape, corner, swatches, copy, keys }) => (
        <li class="card" data-slot={slot} data-shape={shape} data-corner={corner} data-reveal>
          <div class="card-text">
            <div class="card-meta">
              <h3 class="card-label">{copy.label}</h3>
              {keys && (
                <p class="card-keys">
                  <kbd aria-hidden="true">{keys.glyphs}</kbd>
                  <span class="cards-sr">{keys.spoken}</span>
                </p>
              )}
              {swatches && (
                <span class="card-swatches" aria-hidden="true">
                  {themes.map((theme) => (
                    <span data-theme-preview={theme} data-appearance-preview="light" />
                  ))}
                </span>
              )}
            </div>
            <p class="card-body">
              {copy.body.map((run) => (typeof run === 'string' ? run : <code>{run.code}</code>))}
            </p>
          </div>

          <div class="card-media">
            <div
              class="card-well"
              data-theme-preview="tide"
              data-appearance-preview="light"
              aria-hidden="true"
            />
            <div
              class="card-well"
              data-theme-preview="tide"
              data-appearance-preview="dark"
              aria-hidden="true"
            />
            <div class="card-crop">
              <div class="card-window">
                <Clip name={slot} />
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
