---
import '../../styles/home/hero.css'
import { getImage } from 'astro:assets'
import notesDark from '../../assets/iphone/p1-notes-dark.png'
import notesLight from '../../assets/iphone/p1-notes-light.png'
import readingDark from '../../assets/iphone/p2-read-dark.mp4?url'
import readingLight from '../../assets/iphone/p2-read-light.mp4?url'
import { messages } from '../../i18n/index.ts'
import { DOWNLOAD_URL } from '../../site.ts'
import Aurora from '../Aurora.astro'
import Clip from '../Clip.astro'
import InstallNote from '../InstallNote.astro'

const t = messages()

// The widest the phone is drawn is 216 px; twice that covers a 2x screen. Its recording opens on
// the Notes tab, which these stills show, and is 440 by 956 too.
const phone = (src: ImageMetadata) =>
  getImage({ src, width: 440, height: 956, format: 'webp', quality: 82 })
const [phoneDark, phoneLight] = await Promise.all([phone(notesDark), phone(notesLight)])
const phoneSize = { width: phoneDark.attributes.width, height: phoneDark.attributes.height }
---

<section
  id="hero"
  class="hero"
  aria-labelledby="hero-title"
  data-hero
  data-backdrop="css"
  data-scope="dark"
  data-appearance-preview="dark"
>
  <div class="hero-backdrop" aria-hidden="true">
    <div class="hero-sky">
      <Aurora class="hero-fallback" />
      <canvas class="hero-canvas" data-hero-canvas></canvas>
    </div>
    <div class="hero-grain"></div>
    <div class="hero-sheen"></div>
    <div class="hero-dome"></div>
  </div>

  <div class="hero-copy">
    <h1 id="hero-title" class="hero-title">
      {t.hero.titleLines.map((line, index) => (
        <>
          {index > 0 && ' '}
          <span class="hero-line">
            {line}
            {index === t.hero.titleLines.length - 1 && (
              <>
                {' '}
                <span class="site-accent hero-accent">{t.hero.titleAccent}</span>
              </>
            )}
          </span>
        </>
      ))}
    </h1>
    <p class="hero-lead">{t.hero.lead}</p>
  </div>

  <div class="hero-cta" data-hero-cta>
    <div class="hero-cta-inner">
      <div class="action-row">
        <a
          class="brand-button hero-download"
          href={DOWNLOAD_URL}
          aria-describedby="download-requirements"
        >
          <svg
            class="brand-button-glyph"
            viewBox="0 0 16 16"
            width="16"
            height="16"
            aria-hidden="true"
          >
            <path d="M8 2.5v7.25M4.75 6.75 8 10l3.25-3.25M3 13h10"></path>
          </svg>
          {t.download.label}
        </a>
        <a class="quiet-button" href="#iphone">
          {t.download.iphone}
        </a>
      </div>
      <p class="hero-requirements" id="download-requirements">
        {t.download.requirements}
      </p>
      <InstallNote />
    </div>
  </div>

  <div class="hero-stage">
    <div class="hero-rig">
      <div class="hero-window">
        <div class="hero-frame">
          <Clip name="hero" scheme="dark" class="hero-clip" priority />
          <div class="hero-day" data-hero-day hidden>
            <Clip name="hero" scheme="light" as="hero-day" class="hero-clip" />
          </div>
        </div>
      </div>
    </div>
    <div class="hero-phone">
      <video
        class="hero-phone-screen"
        data-hero-phone="night"
        width={phoneSize.width}
        height={phoneSize.height}
        poster={phoneDark.src}
        aria-label={t.media.iphoneReading}
        preload="none"
        tabindex="-1"
        muted
        loop
        playsinline
      >
        <source data-src={readingDark} type="video/mp4" />
      </video>
      <noscript>
        <img
          class="hero-phone-screen"
          src={phoneDark.src}
          width={phoneSize.width}
          height={phoneSize.height}
          alt={t.media.iphoneNotes}
          decoding="async"
        />
      </noscript>
      <video
        class="hero-phone-screen hero-phone-day"
        data-hero-phone="day"
        width={phoneSize.width}
        height={phoneSize.height}
        data-poster={phoneLight.src}
        aria-hidden="true"
        preload="none"
        tabindex="-1"
        muted
        loop
        playsinline
        hidden
      >
        <source data-src={readingLight} type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<script>
  import { startHero } from '../../scripts/hero.ts'

  startHero()
</script>
