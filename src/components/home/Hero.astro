---
import '../../styles/home/hero.css'
import { getImage } from 'astro:assets'
import notesDark from '../../assets/iphone/p1-notes-dark.png'
import notesLight from '../../assets/iphone/p1-notes-light.png'
import { messages } from '../../i18n/index.ts'
import { DOWNLOAD_URL } from '../../site.ts'
import Aurora from '../Aurora.astro'
import Clip from '../Clip.astro'
import InstallNote from '../InstallNote.astro'

const t = messages()

// The widest the phone is drawn is 216 px; twice that covers a 2x screen.
const phone = (src: ImageMetadata) => getImage({ src, width: 440, format: 'webp', quality: 82 })
const [phoneDark, phoneLight] = await Promise.all([phone(notesDark), phone(notesLight)])
---

<section
  id="hero"
  class="hero"
  aria-labelledby="hero-title"
  data-hero
  data-backdrop="css"
  data-scope="dark"
  data-appearance-preview="dark"
>
  <div class="hero-backdrop" aria-hidden="true">
    <div class="hero-sky">
      <Aurora class="hero-fallback" />
      <canvas class="hero-canvas" data-hero-canvas></canvas>
    </div>
    <div class="hero-grain"></div>
    <div class="hero-sheen"></div>
    <div class="hero-dome"></div>
  </div>

  <div class="hero-copy">
    <h1 id="hero-title" class="hero-title">
      {t.hero.titleLines.map((line, index) => (
        <>
          {index > 0 && ' '}
          <span class="hero-line">
            {line}
            {index === t.hero.titleLines.length - 1 && (
              <>
                {' '}
                <span class="site-accent hero-accent">{t.hero.titleAccent}</span>
              </>
            )}
          </span>
        </>
      ))}
    </h1>
    <p class="hero-lead">{t.hero.lead}</p>
  </div>

  <div class="hero-cta" data-hero-cta>
    <div class="hero-cta-inner">
      <div class="action-row">
        <a
          class="brand-button hero-download"
          href={DOWNLOAD_URL}
          aria-describedby="download-requirements"
        >
          <svg
            class="brand-button-glyph"
            viewBox="0 0 16 16"
            width="16"
            height="16"
            aria-hidden="true"
          >
            <path d="M8 2.5v7.25M4.75 6.75 8 10l3.25-3.25M3 13h10"></path>
          </svg>
          {t.download.label}
        </a>
        <a class="quiet-button" href="#iphone">
          {t.download.iphone}
        </a>
      </div>
      <p class="hero-requirements" id="download-requirements">
        {t.download.requirements}
      </p>
      <InstallNote />
    </div>
  </div>

  <div class="hero-stage">
    <div class="hero-rig">
      <div class="hero-window">
        <div class="hero-frame">
          <Clip name="hero" scheme="dark" class="hero-clip" priority />
          <div class="hero-day" data-hero-day hidden>
            <Clip name="hero" scheme="light" as="hero-day" class="hero-clip" />
          </div>
        </div>
      </div>
    </div>
    <div class="hero-phone">
      <img
        src={phoneDark.src}
        width={phoneDark.attributes.width}
        height={phoneDark.attributes.height}
        alt={t.media.iphoneNotes}
        decoding="async"
      />
      <img
        class="hero-phone-day"
        src={phoneLight.src}
        width={phoneLight.attributes.width}
        height={phoneLight.attributes.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<script>
  import { startHero } from '../../scripts/hero.ts'

  startHero()
</script>
