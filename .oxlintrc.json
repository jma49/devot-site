{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "import/no-named-as-default-member": "off",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect"]
      }
    ],
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ]
  },
  "ignorePatterns": [
    "dist/**",
    ".astro/**",
    "node_modules/**",
    "playwright-report/**",
    "test-results/**"
  ]
}
